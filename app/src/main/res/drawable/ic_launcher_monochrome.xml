<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon monochrome layer — the themed-icon variant.

    Designed rather than inherited. A monochrome drawable is re-tinted whole, so
    every colour distinction in the foreground collapses: the amber pane and the
    white frame become the same ink. Reusing the foreground would therefore fill
    the top-left pane solid *and* butt it against a 6-wide frame and a 3-wide
    mullion, and at 48dp that corner merges into one blob. The pane stops reading
    as a lit cell and starts reading as a thicker corner.

    So the accent is inset instead, with 3 units of clear ground on every side —
    the same 3 the mullions use, so the spacing is not arbitrary. It reads as a
    mark *inside* a pane rather than as part of the joinery.

    WHY NOT A HOLLOW PANE. That was the first idea and the geometry rules it
    out. The top-left pane's interior is 14 x 11, and it is the smallest of the
    four by design. An outline inside it, inset far enough not to touch the
    frame and stroked heavily enough to survive, leaves a hole of roughly 5 x 2
    units — 3.3 x 1.3 px at a 48dp icon on an mdpi screen. It closes up and the
    pane reads as solid anyway, only messier. A filled inset block is the honest
    version of the same idea: 8 x 5 units, 5.3 x 3.3 dp, which holds.

    Everything else matches the foreground exactly, including the safe-zone
    geometry (outermost point r = 30.02, inside the recommended 33).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The lit pane, inset so it cannot merge with the frame or the mullion. -->
    <path
        android:pathData="M38,41 H46 V46 H38 Z"
        android:fillColor="#FFFFFF" />

    <path
        android:pathData="M37,35 H71 A5,5 0 0 1 76,40 V68 A5,5 0 0 1 71,73 H37 A5,5 0 0 1 32,68 V40 A5,5 0 0 1 37,35 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M50.5,35 V73"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />
    <path
        android:pathData="M32,50.5 H76"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />
</vector>
