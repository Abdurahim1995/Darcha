<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground (T24): a little window.

    "Darcha" means *little window*, and a window with panes is already a grid —
    the same shape as a spreadsheet, without having to draw a spreadsheet. The
    playbook's original "K" motif was a letterform from when the app was called
    Katak; a letter would say nothing about what the app does, and nothing at all
    to someone who does not read Latin script.

    Everything sits inside the 66dp safe zone of the 108dp canvas (21dp inset on
    each side), so no launcher mask can clip the frame.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Window frame: a rounded square, drawn as a stroke. -->
    <path
        android:pathData="M30,30 h48 a6,6 0 0 1 6,6 v36 a6,6 0 0 1 -6,6 h-48 a6,6 0 0 1 -6,-6 v-36 a6,6 0 0 1 6,-6 z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:strokeLineJoin="round" />

    <!-- The mullions that make it panes — and a grid. -->
    <path
        android:pathData="M54,30 V78"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5" />
    <path
        android:pathData="M24,54 H84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5" />

    <!-- One pane lit, the way a selected cell is. Keeps the mark from reading
         as a plain window and hints that this one is about the contents. -->
    <path
        android:pathData="M57.5,57.5 h23 v17 h-23 z"
        android:fillColor="#D0BCFF" />
</vector>
